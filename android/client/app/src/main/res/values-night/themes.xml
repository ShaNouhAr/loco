<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Mode sombre de l'appareil : thème « sombre doux » du portail (apparence Brume). -->
    <style name="LocoTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/loco_canvas</item>
        <item name="android:statusBarColor">@color/loco_canvas</item>
        <item name="android:navigationBarColor">@color/loco_canvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/loco_text</item>
        <item name="android:colorControlActivated">@color/loco_text</item>
        <item name="android:textColorHighlight">@color/loco_line2</item>
    </style>
</resources>
