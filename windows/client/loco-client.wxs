<?xml version="1.0" encoding="utf-8"?>
<!-- Installeur MSI de l'agent Windows loco-client (construit par build.sh avec wixl).
     msiexec /i loco-client.msi SERVER=https://loco:8443 KEY=CLE CA_SHA256=EMPREINTE /qn
     Sans propriétés (GPO) : réglages dans HKLM\SOFTWARE\Policies\loco\Client (Server, Key, CaSha256). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="loco-client" Language="1036" Codepage="1252" Version="$(var.Version)"
           Manufacturer="loco" UpgradeCode="ce61fcd5-c143-478b-ad84-03873b29b8d6">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="Agent du parc loco (inventaire, mises à jour)" Comments="https://github.com/ShaNouhAr/loco" />
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="Une version plus récente de loco-client est déjà installée." />
    <Media Id="1" Cabinet="client.cab" EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/ShaNouhAr/loco" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- Emplacements d'inscription gravés à la volée par le portail quand le poste télécharge « son » MSI
         (double-clic = installation ET inscription). Le portail les remplit d'espaces pour le MSI générique
         (ps1, GPO : réglages passés en propriétés ou dans HKLM\SOFTWARE\Policies\loco\Client). -->
    <Property Id="SERVER" Secure="yes" Value="@LOCO_PROVISION_SERVER@........................................................................................................................................." />
    <Property Id="KEY" Secure="yes" Value="@LOCO_PROVISION_KEY@............................................................................" />
    <!-- La clé d'inscription n'apparaît pas dans les journaux de Windows Installer. -->
    <Property Id="MsiHiddenProperties" Value="KEY" />
    <Property Id="CA_SHA256" Secure="yes" Value="@LOCO_PROVISION_CA@............................................................................................................." />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="loco-client">
          <Component Id="Service" Guid="bb3352f7-fe8b-4c9b-921f-0765e8872e7f" Win64="yes">
            <!-- wixl ne lit pas la version PE : sans cette valeur, Windows ignore le composant
                 lors d'une réinstallation, puis la suppression de l'ancien MSI retire le service. -->
            <File Id="ClientExe" Name="loco-client.exe" Source="$(var.SourceDir)/loco-client.exe"
                  DefaultVersion="$(var.Version).0" KeyPath="yes" />
            <File Id="TrayExe" Name="loco-tray.exe" Source="$(var.SourceDir)/loco-tray.exe" DefaultVersion="$(var.Version).0" />
            <File Id="TrayConfig" Name="loco-tray.exe.config" Source="$(var.SourceDir)/loco-tray.exe.config" />
            <File Id="DesktopExe" Name="loco-desktop.exe" Source="$(var.SourceDir)/loco-desktop.exe" DefaultVersion="$(var.Version).0" />
            <File Id="DesktopConfig" Name="loco-desktop.exe.config" Source="$(var.SourceDir)/loco-desktop.exe.config" />
            <File Id="ClientConfig" Name="loco-client.exe.config" Source="$(var.SourceDir)/loco-client.exe.config" />
            <ServiceInstall Id="ClientService" Name="loco-client" DisplayName="loco - agent du parc"
                            Description="Inventaire et mises à jour du poste, piloté depuis le serveur loco."
                            Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes" />
            <ServiceControl Id="ClientServiceControl" Name="loco-client" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
          <Component Id="TrayStartup" Guid="7fc05df1-9b97-4e9c-b360-3714d77d21f0" Win64="yes">
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Run">
              <RegistryValue Name="loco" Type="string" Value="&quot;[INSTALLDIR]loco-tray.exe&quot;" KeyPath="yes" />
            </RegistryKey>
          </Component>
          <!-- Valeurs vides sans propriétés (GPO : HKLM\SOFTWARE\Policies\loco\Client est lu en premier). -->
          <Component Id="Settings" Guid="28201fb5-7923-40fe-a669-e306a13740be" Win64="yes">
            <RegistryKey Root="HKLM" Key="SOFTWARE\loco\Client">
              <RegistryValue Name="Server" Type="string" Value="[SERVER]" KeyPath="yes" />
              <RegistryValue Name="Key" Type="string" Value="[KEY]" />
              <RegistryValue Name="CaSha256" Type="string" Value="[CA_SHA256]" />
            </RegistryKey>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Client" Level="1">
      <ComponentRef Id="Service" />
      <ComponentRef Id="Settings" />
      <ComponentRef Id="TrayStartup" />
    </Feature>
  </Product>
</Wix>
