#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
# loco (appliance Alpine) : supervisord lance le portail, nginx et les tâches périodiques
# (configuration générée par install.sh dans /etc/supervisor/loco.conf). Agent root : loco-agent.
name="loco"
description="loco : portail, caches et dépôts"
supervisor=supervise-daemon
command=/usr/bin/supervisord
command_args="-n -c /etc/supervisor/loco.conf"

depend() {
    need net localmount
    after firewall
}

start_pre() {
    # /run est en mémoire : dossiers de nginx et de squid recréés à chaque démarrage.
    checkpath -d -m 0755 -o nginx:nginx /run/nginx
    checkpath -d -m 0755 /run/squid
    checkpath -d -m 0755 /var/log/loco
}
