[Unit]
Description=loco - portail web
Documentation=https://github.com/ShaNouhAr/loco
After=network-online.target
Wants=network-online.target

[Service]
User=loco
Group=loco
SupplementaryGroups=@LOG_GROUP@
Environment=LOCO_DATA=@DATA@
Environment=LOCO_STATE=/var/lib/loco
Environment=LOCO_ETC=/etc/loco
Environment=LOCO_PUBLIC_URL=@HTTP_URL@
Environment=LOCO_ADMIN_URL=@ADMIN_URL@
Environment=LOCO_HOST=@HOST@
Environment=LOCO_ACNG_PORT=3142
Environment=LOCO_WU_PROXY_PORT=@WU_PROXY_PORT@
Environment=LOCO_WU_PROXY=@WU_PROXY@
Environment=LOCO_BACKUP_DIR=@BACKUP_DIR@
Environment=LOCO_FLATPAK=@FLATPAK@
Environment=LOCO_RPM=@RPM@
Environment=TMPDIR=@DATA@/.tmp
@PROXY_ENV@
WorkingDirectory=/opt/loco/portal
ExecStart=@GUNICORN@ @GUNICORN_FLAGS@ --workers 1 --threads 8 --timeout 120 --bind 127.0.0.1:@APP_PORT@ --access-logfile - --access-logformat "%%(h)s %%(m)s %%(U)s %%(s)s" app:app
Restart=always
RestartSec=3

# Confinement
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=@DATA@ /var/lib/loco
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
