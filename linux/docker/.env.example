# loco en conteneur : copier en .env, adapter, puis docker compose up -d --build.
# Une variable vide ou absente prend la valeur par défaut indiquée ; les modifications
# s'appliquent au prochain démarrage (docker compose up -d).

# Adresse annoncée aux postes (défaut : IP de la route par défaut de l'hôte).
LOCO_HOST=
# Ports HTTPS (interface et postes) et HTTP d'amorçage (8443 et 8088).
LOCO_HTTPS_PORT=8443
# Adresse du portail pour les navigateurs (https://nom:port), si elle diffère de celle des agents. Elle doit figurer dans le certificat.
LOCO_PORTAL_URL=
LOCO_HTTP_PORT=8088
# 0 : pas de port HTTP (autorité HTTPS déjà déployée sur les postes).
LOCO_HTTP=1
# Réseaux autorisés : postes, puis interface d'administration (défaut : réseaux privés).
LOCO_ALLOW=
LOCO_ADMIN_ALLOW=
# Proxy HTTP d'entreprise pour sortir sur Internet, ex. http://proxy.exemple.lan:3128 (défaut : accès direct).
LOCO_PROXY=
# Cache Windows Update (ports 80 et 443 de l'hôte), Flatpak, famille Red Hat : 1 ou 0.
LOCO_WU=1
LOCO_FLATPAK=1
LOCO_RPM=1
# Tailles maximales des caches, ex. 50g (défaut : calculées au premier démarrage).
LOCO_WU_CACHE_SIZE=
LOCO_FLATPAK_CACHE_SIZE=
LOCO_RPM_CACHE_SIZE=
# DNS du cache Windows Update (défaut : "1.1.1.1 9.9.9.9").
LOCO_RESOLVERS=
# Taille max d'un fichier envoyé au portail (défaut : 8g).
LOCO_MAX_UPLOAD=
# Sauvegardes quotidiennes à 03:30 conservées (0 : désactivées) et fuseau horaire.
LOCO_BACKUP_KEEP=3
TZ=Europe/Paris
# Dossiers de l'hôte pour les données (dépôts et caches, volumineux) et les sauvegardes
# (défaut : volumes Docker). Ex. LOCO_DATA_DIR=/srv/loco
LOCO_DATA_DIR=
LOCO_BACKUP_DIR=
# Certificat d'entreprise monté dans le conteneur (voir docker-compose.yml), sinon autorité locale.
LOCO_TLS_CERT=
LOCO_TLS_KEY=
