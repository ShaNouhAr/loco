#!/bin/bash
# loco : sauvegarde et restauration (root).
#   loco-backup create [DOSSIER]   archive configuration, comptes, clés, dépôt APT et catalogue Windows
#                                        (hors caches) ; garde les BACKUP_KEEP plus récentes
#   loco-backup restore ARCHIVE    restaure une archive (même serveur ou nouveau serveur, loco
#                                        déjà installé) ; la configuration locale (IP, ports, réseaux) est gardée
#   loco-backup list
set -euo pipefail
[ "$(id -u)" -eq 0 ] || { echo "Lancez cette commande en root (sudo)." >&2; exit 1; }
# shellcheck disable=SC1091
. /etc/loco/loco.conf
DEST="${BACKUP_DIR:-/var/backups/loco}"
KEEP="${BACKUP_KEEP:-3}"
STATE=/var/lib/loco

case "${1:-}" in
    create)
        DEST="${2:-$DEST}"
        install -d -m 750 -o root -g loco "$DEST"
        work=$(mktemp -d)
        trap 'rm -rf "$work"' EXIT
        chown loco "$work"
        # Copie cohérente de la base, même pendant une écriture.
        runuser -u loco -- "${PYTHON:-python3}" -c "import sys; sys.path.insert(0,'/opt/loco/portal'); from locosnapshot import snapshot; snapshot(sys.argv[1],sys.argv[2])" \
            "$STATE/portal.db" "$work/portal.db"
        name="loco-$(hostname)-$(date +%Y%m%d-%H%M%S).tar.gz"
        S="${STATE#/}" D="${DATA#/}"
        paths=(etc/loco "$S" "$D/apt" "$D/win")
        if [ -d "$DATA/flatpak" ]; then paths+=("$D/flatpak"); fi
        if [ -d "$DATA/rpm" ]; then paths+=("$D/rpm"); fi
        rc=0
        # Les versions de déploiement partagent parfois l'inode du catalogue : archiver leur contenu
        # pour qu'une restauration puisse matérialiser chaque fichier sans liens entre chemins.
        tar --hard-dereference -czf "$work/$name" --warning=no-file-changed \
            --exclude=etc/loco/install-state --exclude="$S/portal.db" --exclude="$S/portal.db-*" --exclude="$S/gnupg/S.*" \
            --exclude="$D/win/*/.*" \
            --exclude="$D/flatpak/repo/tmp" \
            -C / "${paths[@]}" \
            -C "$work" portal.db || rc=$?
        [ "$rc" -le 1 ] || { echo "Échec de l'archivage (tar : $rc)." >&2; exit 1; }
        install -m 600 "$work/$name" "$DEST/$name"
        if [ "$KEEP" -gt 0 ]; then
            # shellcheck disable=SC2012  # noms générés par ce script
            ls -1t "$DEST"/loco-*.tar.gz 2>/dev/null | tail -n +"$((KEEP + 1))" | xargs -r rm -f
        fi
        echo "$DEST/$name ($(du -h "$DEST/$name" | cut -f1))"
        ;;
    restore)
        archive="${2:-}"
        [ -f "$archive" ] || { echo "Archive introuvable : $archive" >&2; exit 1; }
        tar -tzf "$archive" | grep -qx "portal.db" || { echo "Ce n'est pas une sauvegarde loco." >&2; exit 1; }
        if [ "${LOCO_RUNTIME:-}" = container ] || [ -f /etc/alpine-release ]; then
            sup_state=$(supervisorctl -c /etc/supervisor/loco.conf status loco-portal 2>/dev/null || true)
            if ! grep -qE '^loco-portal[[:space:]]+STOPPED' <<< "$sup_state"; then
                supervisorctl -c /etc/supervisor/loco.conf stop loco-portal >/dev/null
            fi
        else
            systemctl stop loco-portal
        fi
        # La configuration propre à ce serveur (IP, ports, réseaux) est conservée ; le reste est restauré.
        "${PYTHON:-python3}" /opt/loco/portal/loco/backup.py "$archive" "$DATA"
        chown root:loco /etc/loco/portal.secret
        rm -f "$STATE/portal.db-wal" "$STATE/portal.db-shm"
        if id loco >/dev/null 2>&1; then
            chown -R loco:loco "$STATE" "$DATA/apt" "$DATA/win"
            if [ -d "$DATA/flatpak" ]; then chown -R loco:loco "$DATA/flatpak"; fi
            if [ -d "$DATA/rpm" ]; then chown -R loco:loco "$DATA/rpm"; fi
        fi
        if [ "${LOCO_RUNTIME:-}" = container ]; then
            echo "Archive restaurée. Redémarrez maintenant le conteneur pour régénérer la configuration :"
            echo "    docker compose restart loco"
        elif [ -f /etc/alpine-release ]; then
            echo "Archive restaurée. Relancez l'installation pour régénérer services et configuration :"
            printf '    bash %q/linux/install.sh\n' "$SOURCE_DIR"
        else
            echo "Archive restaurée. Relancez maintenant l'installation pour régénérer services et configuration :"
            echo "    sudo ./install.sh      (depuis le dossier du projet)"
        fi
        ;;
    list)
        find "$DEST" -maxdepth 1 -type f \( -name 'loco-*.tar.gz' -o -name 'local-repo-*.tar.gz' \) -exec ls -lh {} +
        ;;
    *)
        sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
