#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034
# Appliance loco (ISO) : installation de loco au premier démarrage du système installé, avec les réglages de
# l'installateur (/etc/loco/firstboot.args : sources, puis une option d'install.sh par ligne). Supprimé après succès ;
# en cas d'échec, nouvelle tentative au démarrage suivant (journal : /var/log/loco-firstboot.log).
name="loco-firstboot"
description="loco : installation au premier démarrage"
ARGS=/etc/loco/firstboot.args
LOG=/var/log/loco-firstboot.log
# Langue de la console : français si LANG/LC_* commence par « fr », espagnol par « es », anglais sinon.
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in fr*) LOCO_LANG=fr ;; es*) LOCO_LANG=es ;; *) LOCO_LANG=en ;; esac
t() { case "$LOCO_LANG" in fr) printf '%s' "$1" ;; es) printf '%s' "${3:-$2}" ;; *) printf '%s' "$2" ;; esac; }

depend() {
    need localmount net
    after networking chronyd
}

start() {
    [ -f "$ARGS" ] || return 0
    ebegin "$(t 'Installation de loco (premier démarrage, quelques minutes)' 'Installing loco (first boot, a few minutes)' 'Instalando loco (primer arranque, unos minutos)')"
    src=$(head -n 1 "$ARGS")
    set --
    while IFS= read -r arg; do set -- "$@" "$arg"; done <<EOT
$(tail -n +2 "$ARGS")
EOT
    if bash "$src/linux/install.sh" "$@" > "$LOG" 2>&1; then
        rm -f "$ARGS"
        rc-update del loco-firstboot default >/dev/null 2>&1
        rm -f /etc/init.d/loco-firstboot
        eend 0
    else
        tail -n 15 "$LOG" >&2
        # shellcheck source=linux/lib/appliance.sh
        . "$src/linux/lib/appliance.sh" && appliance_issue
        eend 1 "$(t "échec : $LOG (nouvelle tentative au prochain démarrage)" "failed: $LOG (retry at next boot)" "error: $LOG (nuevo intento en el próximo arranque)")"
    fi
}
